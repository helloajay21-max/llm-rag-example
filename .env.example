# Example environment variables (do NOT commit real secrets)
# 1) Copy this file to .env
# 2) Fill values
# 3) Use values to configure Azure and GitHub Secrets

# -------------------------------
# App runtime (local and Azure)
# -------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SQLITE_DB_PATH=data.db
WEBSITES_PORT=8501

# -------------------------------
# Docker Hub (image registry)
# -------------------------------
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TOKEN=your-dockerhub-token
IMAGE_NAME=mcp-streamlit

# -------------------------------
# Azure resources
# -------------------------------
AZURE_SUBSCRIPTION_ID=cf9cf236-9d67-496c-97b1-5485d32f0dd3
AZURE_LOCATION=Central India
RESOURCE_GROUP=Ajay-Practice
APP_SERVICE_PLAN=mcp-app-plan
WEBAPP_NAME=mcp-webapp
KEY_VAULT_NAME=ajayvault21

# Used once to create KEY_VAULT secret OpenAIKey:
OPENAI_KEY_FOR_KEYVAULT=sk-xxxxxxxxxxxxxxxx

# Local file path for AZURE_CREDENTIALS JSON created by:
# az ad sp create-for-rbac --name mcp-github-sp --role Contributor --scopes /subscriptions/<AZURE_SUBSCRIPTION_ID> --sdk-auth
AZURE_CREDENTIALS_FILE=./az-creds.json
